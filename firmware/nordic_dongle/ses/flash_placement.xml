<!DOCTYPE Linker_Placement_File>
<!--
  Application placement for a PCA10059 dongle running S140 7.2.0 with Nordic's
  factory bootloader.

  FLASH_START is 0x27000: the SoftDevice occupies the space below it. The
  bootloader and its settings page sit at the top of flash, which is why the
  application region stops short of 0x100000. These figures come from the
  SoftDevice release notes and the dongle's bootloader, and are repeated in the
  project file's linker_section_placement_macros; if the SoftDevice is ever
  changed, both must change together.

  Traces to: BLE-DD-BUILD.
-->
<Root name="Flash Section Placement">
  <MemorySegment name="FLASH" start="$(FLASH_START)" size="$(FLASH_SIZE)">
    <ProgramSection alignment="0x100" load="Yes" name=".vectors" start="$(FLASH_START)" />
    <ProgramSection alignment="4" load="Yes" name=".init" />
    <ProgramSection alignment="4" load="Yes" name=".init_rodata" />
    <ProgramSection alignment="4" load="Yes" name=".text" />
    <ProgramSection alignment="4" load="Yes" name=".dtors" />
    <ProgramSection alignment="4" load="Yes" name=".ctors" />
    <ProgramSection alignment="4" load="Yes" name=".rodata" />
    <ProgramSection alignment="4" load="Yes" name=".ARM.exidx" address_symbol="__exidx_start" end_symbol="__exidx_end" />
    <ProgramSection alignment="4" load="Yes" name="sdh_ble_observers" inputsections="*(SORT(.sdh_ble_observers*))" address_symbol="__start_sdh_ble_observers" end_symbol="__stop_sdh_ble_observers" />
    <ProgramSection alignment="4" load="Yes" name="sdh_soc_observers" inputsections="*(SORT(.sdh_soc_observers*))" address_symbol="__start_sdh_soc_observers" end_symbol="__stop_sdh_soc_observers" />
    <ProgramSection alignment="4" load="Yes" name="sdh_req_observers" inputsections="*(SORT(.sdh_req_observers*))" address_symbol="__start_sdh_req_observers" end_symbol="__stop_sdh_req_observers" />
    <ProgramSection alignment="4" load="Yes" name="sdh_state_observers" inputsections="*(SORT(.sdh_state_observers*))" address_symbol="__start_sdh_state_observers" end_symbol="__stop_sdh_state_observers" />
    <ProgramSection alignment="4" load="Yes" name="sdh_stack_observers" inputsections="*(SORT(.sdh_stack_observers*))" address_symbol="__start_sdh_stack_observers" end_symbol="__stop_sdh_stack_observers" />
    <ProgramSection alignment="4" load="Yes" name="log_const_data" inputsections="*(SORT(.log_const_data*))" address_symbol="__start_log_const_data" end_symbol="__stop_log_const_data" />
  </MemorySegment>
  <MemorySegment name="RAM" start="$(RAM_START)" size="$(RAM_SIZE)">
    <ProgramSection alignment="0x100" load="No" name=".vectors_ram" address_symbol="__app_ram_start__" />
    <ProgramSection alignment="4" load="No" name=".fast_run" />
    <ProgramSection alignment="4" load="No" name=".data_run" />
    <ProgramSection alignment="4" load="No" name=".tdata_run" />
    <ProgramSection alignment="4" load="No" name=".bss" />
    <ProgramSection alignment="4" load="No" name=".tbss" />
    <ProgramSection alignment="4" load="No" name=".non_init" />
    <ProgramSection alignment="4" size="__HEAP_SIZE__" load="No" name=".heap" />
    <ProgramSection alignment="8" size="__STACK_SIZE__" load="No" place_from_segment_end="Yes" name=".stack" />
    <ProgramSection alignment="4" load="No" name="log_dynamic_data" inputsections="*(SORT(.log_dynamic_data*))" address_symbol="__start_log_dynamic_data" end_symbol="__stop_log_dynamic_data" />
  </MemorySegment>
</Root>
