# Kepler sensor receive: 433.425 MHz, 2-FSK 100 kbps, 20 kHz dev, 150 kHz filter;
# basic packets, variable length, address byte, CRC-16 0x8005; both sync words.
#
# Captured from the STEVAL-FKI433V2 kit on 2026-09-27 after setting it up to the
# sensor firmware's values. On 2026-09-28 (#87) the sync words were changed to
# match the S2-LP DK GUI setup that rf_monitor captures with: the reference
# project's st_eval/Spirit_GUI_Configuration.dat programs the primary sync word,
# 0x4E63F358 (gateway to sensor). Its setup guide then writes the secondary,
# 0xB19C0CA7 (sensor to gateway), into PCKT_FLT_GOALS3..0 and sets
# PCKTCTRL1.SECOND_SYNC_SEL, so both directions are received. Sync bytes are
# stored least significant byte first.
#
# Apply with reset=defaults (the CLI's --setup does).
SYNT3                  0x72   # PLL_CP_ISEL=3 BS=1 SYNT_27_24=2
SYNT2                  0x2A   # SYNT=42
SYNT1                  0xC9   # SYNT=201
SYNT0                  0xF3   # SYNT=243
IF_OFFSET_ANA          0x2F   # IF_OFFSET_ANA=47
IF_OFFSET_DIG          0xC2   # IF_OFFSET_DIG=194
MOD4                   0x06   # DATARATE_M=6
MOD3                   0x25   # DATARATE_M=37
MOD2                   0x09   # DATARATE_E=9
MOD0                   0xA3   # FDEV_M=163
CHFLT                  0x62   # CHFLT_M=6 CHFLT_E=2
PCKTCTRL5              0x20   # PREAMBLE_LEN=32
PCKTCTRL4              0x08   # ADDRESS_LEN=1
PCKTCTRL3              0x00
PCKTCTRL2              0x01   # FIX_VAR_LEN=1
PCKTCTRL1              0x42   # CRC_MODE=2 SECOND_SYNC_SEL=1
SYNC3                  0x58   # primary sync 0x4E63F358, gateway to sensor
SYNC2                  0xF3
SYNC1                  0x63
SYNC0                  0x4E
PROTOCOL1              0x01   # AUTO_PCKT_FLT=1
PCKT_FLT_OPTIONS       0x41   # RX_TIMEOUT_AND_OR_SEL=1 CRC_FLT=1
PCKT_FLT_GOALS3        0xA7   # secondary sync 0xB19C0CA7, sensor to gateway
PCKT_FLT_GOALS2        0x0C
PCKT_FLT_GOALS1        0x9C
PCKT_FLT_GOALS0        0xB1
PA_CONFIG1             0x01
PA_CONFIG0             0x8B
